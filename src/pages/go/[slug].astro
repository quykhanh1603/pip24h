---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const brokers = await getCollection('brokers');
	const bySlug = new Map<string, string>();

	for (const broker of brokers) {
		const [locale, ...rest] = broker.id.split('/');
		const slug = rest.join('/');
		if (!bySlug.has(slug) || locale === 'vi') {
			bySlug.set(slug, broker.data.affiliateUrl);
		}
	}

	return [...bySlug.entries()].map(([slug, affiliateUrl]) => ({
		params: { slug },
		props: { affiliateUrl }
	}));
}

const { affiliateUrl } = Astro.props;
---

<!doctype html>
<html>
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex,nofollow" />
		<meta http-equiv="refresh" content={`0;url=${affiliateUrl}`} />
		<link rel="canonical" href={affiliateUrl} />
		<title>Redirecting…</title>
	</head>
	<body>
		<p>Redirecting to <a href={affiliateUrl}>{affiliateUrl}</a>…</p>
	</body>
</html>
