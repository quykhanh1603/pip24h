---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const collections = {
		brokers: await getCollection('brokers'),
		propfirms: await getCollection('propfirms')
	};
	const bySlug = new Map<string, string>();
	const owner = new Map<string, string>();

	for (const [name, entries] of Object.entries(collections)) {
		for (const entry of entries) {
			const [locale, ...rest] = entry.id.split('/');
			const slug = rest.join('/');
			const prev = owner.get(slug);
			if (prev && prev !== name) {
				throw new Error(`/go/${slug}/ is claimed by both "${prev}" and "${name}" — rename one slug.`);
			}
			owner.set(slug, name);
			if (!bySlug.has(slug) || locale === 'en') {
				bySlug.set(slug, entry.data.affiliateUrl);
			}
		}
	}

	return [...bySlug.entries()].map(([slug, affiliateUrl]) => ({
		params: { slug },
		props: { affiliateUrl }
	}));
}

const { affiliateUrl } = Astro.props;
---

<!doctype html>
<html>
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex,nofollow" />
		<meta http-equiv="refresh" content={`0;url=${affiliateUrl}`} />
		<link rel="canonical" href={affiliateUrl} />
		<title>Redirecting…</title>
	</head>
	<body>
		<p>Redirecting to <a href={affiliateUrl}>{affiliateUrl}</a>…</p>
	</body>
</html>
