---
import Layout from '../../layouts/Layout.astro';

const terms = [
	{ term: 'Altcoin', def: 'Bất kỳ đồng tiền mã hóa nào không phải Bitcoin — ví dụ Ethereum, Solana hay XRP.' },
	{ term: 'Balance (Số dư)', def: 'Tổng tiền mặt trong tài khoản giao dịch, chưa tính lãi/lỗ của các lệnh đang mở.' },
	{ term: 'Bid Price (Giá mua)', def: 'Mức giá bạn có thể bán một công cụ giao dịch. Luôn thấp hơn giá Ask một chút.' },
	{ term: 'Ask Price (Giá bán/chào bán)', def: 'Mức giá bạn có thể mua một công cụ giao dịch. Luôn cao hơn giá Bid một chút.' },
	{ term: 'Blockchain (Chuỗi khối)', def: 'Sổ cái phân tán, khó bị chỉnh sửa, ghi lại giao dịch trên nhiều máy tính — công nghệ nền tảng đằng sau Bitcoin và hầu hết tiền mã hóa.' },
	{ term: 'CFD (Hợp đồng chênh lệch)', def: 'Hợp đồng phái sinh cho phép giao dịch theo biến động giá của một tài sản mà không cần sở hữu tài sản đó. Lãi/lỗ tính theo chênh lệch giữa giá mở và giá đóng lệnh.' },
	{ term: 'Cold Wallet (Ví lạnh)', def: 'Ví tiền mã hóa lưu trữ offline (ví dụ thiết bị phần cứng), an toàn hơn cho lưu trữ dài hạn vì không kết nối internet nên khó bị tấn công.' },
	{ term: 'Drawdown', def: 'Mức sụt giảm từ đỉnh vốn chủ sở hữu (equity) xuống đáy tiếp theo, thường tính theo phần trăm — chỉ số quan trọng đo mức độ rủi ro.' },
	{ term: 'ECN (Electronic Communication Network)', def: 'Mô hình khớp lệnh trực tiếp giữa các bên tham gia thị trường, thường có spread thấp hơn nhưng tính thêm hoa hồng riêng.' },
	{ term: 'Equity (Vốn chủ sở hữu)', def: 'Số dư tài khoản đã điều chỉnh theo lãi/lỗ tạm tính (floating) của các lệnh đang mở.' },
	{ term: 'Fill (Khớp lệnh)', def: 'Việc hoàn tất một lệnh ở mức giá cụ thể — một lệnh được coi là "khớp" khi thực thi đầy đủ.' },
	{ term: 'FOMC (Ủy ban Thị trường Mở Liên bang)', def: 'Ủy ban của Cục Dự trữ Liên bang Mỹ quyết định chính sách lãi suất — các cuộc họp của ủy ban này nằm trong số sự kiện được theo dõi sát nhất trong forex.' },
	{ term: 'Fundamental Analysis (Phân tích cơ bản)', def: 'Đánh giá giá trị một đồng tiền dựa trên dữ liệu kinh tế, lãi suất và sự kiện địa chính trị, thay vì mẫu hình biểu đồ.' },
	{ term: 'Gap (Khoảng trống giá)', def: 'Bước nhảy giá từ mức này sang mức khác mà không có giao dịch ở giữa, thường thấy khi thị trường mở cửa lại sau cuối tuần hoặc ngày lễ.' },
	{ term: 'Grid Trading (Giao dịch lưới)', def: 'Chiến lược đặt một loạt lệnh mua và bán ở các khoảng giá cố định trên và dưới giá hiện tại, nhằm kiếm lời từ biến động thị trường bình thường.' },
	{ term: 'Hedging (Phòng hộ)', def: 'Mở một lệnh để bù trừ rủi ro cho một lệnh khác đang có — ví dụ giữ cả lệnh mua và bán trên cùng một cặp tiền.' },
	{ term: 'Hot Wallet (Ví nóng)', def: 'Ví tiền mã hóa kết nối internet, tiện cho giao dịch thường xuyên nhưng dễ bị tấn công hơn ví lạnh.' },
	{ term: 'Inflation (Lạm phát)', def: 'Tốc độ tăng mặt bằng giá chung của hàng hóa và dịch vụ theo thời gian, làm xói mòn sức mua — yếu tố quan trọng trong quyết định lãi suất của ngân hàng trung ương.' },
	{ term: 'Interbank Market (Thị trường liên ngân hàng)', def: 'Mạng lưới các ngân hàng giao dịch tiền tệ trực tiếp với nhau ở mức giá bán buôn, tạo nền tảng cho thị trường forex rộng lớn hơn.' },
	{ term: 'Jobless Claims (Đơn xin trợ cấp thất nghiệp)', def: 'Báo cáo hằng tuần của Mỹ đếm số đơn xin trợ cấp thất nghiệp mới, dùng làm tín hiệu sớm về sức khỏe thị trường lao động giữa các báo cáo việc làm hằng tháng.' },
	{ term: 'KYC (Xác minh danh tính khách hàng)', def: 'Quy trình xác minh danh tính mà sàn/broker bắt buộc phải hoàn tất trước khi cho phép khách hàng nạp hoặc rút tiền.' },
	{ term: 'Leverage (Đòn bẩy)', def: 'Vốn vay từ sàn giúp bạn kiểm soát vị thế lớn hơn nhiều so với số tiền nạp — ví dụ đòn bẩy 1:100 cho phép $100 kiểm soát vị thế $10.000. Đòn bẩy khuếch đại cả lãi lẫn lỗ.' },
	{ term: 'Limit Order (Lệnh giới hạn)', def: 'Lệnh mua/bán chỉ khớp ở một mức giá xác định hoặc tốt hơn, thay vì khớp ngay theo giá thị trường hiện tại.' },
	{ term: 'Liquidity (Thanh khoản)', def: 'Mức độ dễ dàng mua/bán một tài sản mà không làm giá biến động mạnh. Thị trường thanh khoản cao (như các cặp forex chính) thường có spread thấp hơn.' },
	{ term: 'Lot', def: 'Đơn vị khối lượng giao dịch chuẩn hóa. 1 lot tiêu chuẩn = 100.000 đơn vị tiền cơ sở; 1 lot mini = 10.000; 1 lot micro = 1.000.' },
	{ term: 'Margin (Ký quỹ)', def: 'Phần vốn của chính bạn mà sàn giữ lại làm tài sản đảm bảo để mở và duy trì một vị thế có đòn bẩy.' },
	{ term: 'Margin Call (Gọi ký quỹ)', def: 'Cảnh báo từ sàn khi vốn chủ sở hữu trong tài khoản gần chạm mức ký quỹ yêu cầu, báo hiệu bạn cần nạp thêm tiền hoặc giảm vị thế để tránh bị Stop Out.' },
	{ term: 'Market Maker', def: 'Mô hình sàn tự đối ứng lệnh của khách hàng nội bộ, thay vì chuyển lệnh ra các nhà cung cấp thanh khoản bên ngoài.' },
	{ term: 'Market Order (Lệnh thị trường)', def: 'Lệnh mua/bán khớp ngay lập tức theo mức giá thị trường hiện có.' },
	{ term: 'MetaTrader (MT4/MT5)', def: 'Nền tảng giao dịch bên thứ ba phổ biến nhất trong forex bán lẻ, hỗ trợ biểu đồ, giao dịch tự động (EA) và giao diện chung trên nhiều sàn khác nhau.' },
	{ term: 'Net Position (Vị thế ròng)', def: 'Tổng khối lượng và hướng của tất cả lệnh đang mở trên một công cụ, sau khi bù trừ giữa lệnh mua và lệnh bán.' },
	{ term: 'NFP (Non-Farm Payrolls)', def: 'Báo cáo hằng tháng của Mỹ về số việc làm tạo ra ngoài ngành nông nghiệp, được xem là một trong những sự kiện kinh tế tác động mạnh nhất đến thị trường.' },
	{ term: 'OTC (Over-the-Counter)', def: 'Giao dịch trực tiếp giữa hai bên mà không qua một sàn giao dịch tập trung — đây là cách hầu hết giao dịch forex diễn ra.' },
	{ term: 'Order Book (Sổ lệnh)', def: 'Danh sách các lệnh mua và bán đang chờ khớp ở các mức giá khác nhau cho một công cụ giao dịch.' },
	{ term: 'Phí qua đêm / Swap (Rollover)', def: 'Khoản phí hoặc tiền lãi phát sinh khi giữ một vị thế có đòn bẩy qua thời điểm đóng cửa thị trường hằng ngày, phản ánh chênh lệch lãi suất giữa hai đồng tiền giao dịch.' },
	{ term: 'Pip', def: 'Đơn vị biến động giá nhỏ nhất được chuẩn hóa của một cặp tiền, thường là chữ số thập phân thứ tư (hoặc thứ hai với các cặp có đồng Yên Nhật).' },
	{ term: 'Quantitative Easing - QE (Nới lỏng định lượng)', def: 'Chính sách của ngân hàng trung ương mua tài sản để bơm tiền vào nền kinh tế, thường dùng để hạ lãi suất và kích thích tăng trưởng.' },
	{ term: 'Quote Currency (Đồng tiền định giá)', def: 'Đồng tiền thứ hai trong một cặp, thể hiện cần bao nhiêu đồng tiền đó để mua một đơn vị đồng tiền cơ sở.' },
	{ term: 'Regulator (Cơ quan quản lý)', def: 'Cơ quan nhà nước hoặc tổ chức độc lập (như FCA, ASIC, CySEC) cấp phép và giám sát sàn giao dịch nhằm bảo vệ tiền của khách hàng và đảm bảo hoạt động minh bạch.' },
	{ term: 'Scalping', def: 'Phong cách giao dịch ngắn hạn nhằm kiếm lời từ biến động giá nhỏ, thường giữ lệnh vài giây đến vài phút và vào nhiều lệnh trong ngày.' },
	{ term: 'Slippage (Trượt giá)', def: 'Chênh lệch giữa mức giá bạn kỳ vọng lệnh khớp và mức giá thực tế khớp, thường xảy ra khi thị trường biến động nhanh hoặc thanh khoản thấp.' },
	{ term: 'Spread', def: 'Chênh lệch giữa giá Bid và giá Ask của một công cụ giao dịch — một trong những cách chính sàn thu phí giao dịch.' },
	{ term: 'Stablecoin', def: 'Đồng tiền mã hóa được thiết kế để giữ giá trị ổn định, thường neo tỷ giá 1:1 với một loại tiền pháp định như USD (ví dụ USDT, USDC).' },
	{ term: 'Staking', def: 'Khóa tiền mã hóa để giúp bảo mật một mạng lưới proof-of-stake, đổi lại nhận phần thưởng bằng chính đồng tiền đó.' },
	{ term: 'Stop Loss (Cắt lỗ)', def: 'Lệnh tự động đóng vị thế khi giá chạm đến một mức xác định, dùng để giới hạn mức thua lỗ tối đa.' },
	{ term: 'Stop Out Level (Mức Stop Out)', def: 'Mức ký quỹ mà tại đó sàn sẽ tự động bắt đầu đóng các lệnh đang mở của trader để tránh số dư tài khoản âm.' },
	{ term: 'STP (Straight Through Processing)', def: 'Mô hình sàn chuyển lệnh của khách hàng thẳng đến nhà cung cấp thanh khoản bên ngoài mà không qua bàn giao dịch (dealing desk) trung gian.' },
	{ term: 'Take Profit (Chốt lời)', def: 'Lệnh tự động đóng vị thế khi giá đạt đến mức mục tiêu lợi nhuận đã đặt trước.' },
	{ term: 'Unrealized P&L (Lãi/lỗ chưa thực hiện)', def: 'Lãi hoặc lỗ trên giấy của một vị thế vẫn đang mở — chỉ trở thành "đã thực hiện" khi vị thế được đóng.' },
	{ term: 'Uptrend (Xu hướng tăng)', def: 'Giai đoạn kéo dài mà giá liên tục tạo đỉnh cao hơn và đáy cao hơn.' },
	{ term: 'Volatility (Biến động)', def: 'Mức độ và tốc độ thay đổi giá của một tài sản trong một khoảng thời gian — biến động càng cao, giá dao động càng mạnh và nhanh.' },
	{ term: 'Volume (Khối lượng)', def: 'Tổng khối lượng tài sản được giao dịch trong một khoảng thời gian, thường dùng làm chỉ báo mức độ quan tâm hoặc thanh khoản của thị trường.' },
	{ term: 'Weighted Average (Trung bình có trọng số)', def: 'Mức trung bình cho một số giá trị trọng số cao hơn giá trị khác — ví dụ đường trung bình động cho giá gần đây trọng số cao hơn.' },
	{ term: 'Whipsaw (Giá đảo chiều liên tục)', def: 'Tình trạng thị trường lộn xộn khi giá đảo chiều mạnh và liên tục, thường kích hoạt stop loss ở cả hai phía của một đợt biến động.' },
	{ term: 'XAU/USD (Vàng/USD)', def: 'Ký hiệu giao dịch cho vàng định giá bằng USD, được nhiều sàn forex cung cấp bên cạnh các cặp tiền tệ.' },
	{ term: 'Yield (Lợi suất)', def: 'Thu nhập tạo ra từ việc nắm giữ một tài sản, như lãi suất nhận được — yếu tố chính thúc đẩy sức mạnh tiền tệ trong chiến lược carry trade.' },
	{ term: 'YoY (So với cùng kỳ năm trước)', def: 'Cách so sánh một số liệu với cùng kỳ một năm trước, dùng để loại bỏ yếu tố mùa vụ trong dữ liệu kinh tế.' },
	{ term: 'Zero-Sum Game (Trò chơi có tổng bằng 0)', def: 'Tình huống mà lợi nhuận của một trader này khớp chính xác với khoản lỗ của trader khác — thường dùng để mô tả giao dịch phái sinh có đòn bẩy.' }
];

const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const grouped = new Map<string, typeof terms>();
for (const item of [...terms].sort((a, b) => a.term.localeCompare(b.term))) {
	const letter = item.term[0].toUpperCase();
	if (!grouped.has(letter)) grouped.set(letter, []);
	grouped.get(letter)!.push(item);
}
---

<Layout lang="vi" title="Từ điển thuật ngữ Forex &amp; Crypto — Pip24h" description="Giải thích dễ hiểu các thuật ngữ giao dịch forex và crypto thường gặp: pip, spread, đòn bẩy, ký quỹ và hơn thế nữa.">
	<article class="prose prose-slate dark:prose-invert max-w-none">
		<h1>Từ điển thuật ngữ Forex &amp; Crypto</h1>
		<p>
			Giải thích ngắn gọn, dễ hiểu các thuật ngữ giao dịch mà bạn thường gặp trên website sàn giao
			dịch và trong các bài đánh giá của chúng tôi.
		</p>
	</article>

	<div class="sticky top-16 z-10 -mx-4 mt-6 flex flex-wrap gap-1.5 border-y border-slate-200 bg-slate-50/95 px-4 py-3 backdrop-blur sm:mx-0 sm:rounded-lg sm:border sm:px-3 dark:border-slate-800 dark:bg-slate-950/95">
		{alphabet.map((letter) =>
			grouped.has(letter) ? (
				<a
					href={`#letter-${letter}`}
					class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-300 text-sm font-semibold text-brand-navy hover:border-brand-blue hover:bg-brand-blue-light dark:border-slate-700 dark:text-slate-200 dark:hover:bg-brand-blue/10"
				>
					{letter}
				</a>
			) : (
				<span class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-100 text-sm text-slate-300 dark:border-slate-800 dark:text-slate-700">
					{letter}
				</span>
			)
		)}
	</div>

	<div class="mt-8 space-y-10">
		{[...grouped.entries()].map(([letter, items]) => (
			<section id={`letter-${letter}`} class="scroll-mt-24">
				<h2 class="text-xl font-bold text-brand-blue">{letter}</h2>
				<div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{items.map(({ term, def }) => (
						<div class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
							<h3 class="font-semibold text-brand-navy dark:text-white">{term}</h3>
							<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{def}</p>
						</div>
					))}
				</div>
			</section>
		))}
	</div>
</Layout>
