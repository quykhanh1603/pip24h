---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const guides = (await getCollection('guides', (entry) => entry.id.startsWith('vi/'))).sort(
	(a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf()
);

const categoryLabels: Record<string, string> = {
	basics: 'Kiến thức cơ bản',
	'risk-management': 'Quản lý rủi ro',
	'technical-analysis': 'Phân tích kỹ thuật',
	'chart-patterns': 'Mẫu hình biểu đồ'
};

const dateFormatter = new Intl.DateTimeFormat('vi-VN', { day: 'numeric', month: 'long', year: 'numeric' });

function readingTime(body: string) {
	const words = body.trim().split(/\s+/).length;
	return Math.max(1, Math.round(words / 200));
}
---

<Layout lang="vi" title="Hướng dẫn giao dịch — Pip24h" description="Các bài hướng dẫn dễ hiểu về kiến thức forex cơ bản, quản lý rủi ro, phân tích kỹ thuật và mẫu hình biểu đồ.">
	<h1 class="text-2xl font-bold text-brand-navy dark:text-white">Hướng dẫn giao dịch</h1>
	<p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
		Hiển thị <span class="font-semibold text-brand-navy dark:text-white">{guides.length}</span> hướng dẫn
	</p>

	<div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
		{guides.map((guide) => (
			<a
				href={`/vi/guides/${guide.id.split('/').slice(1).join('/')}/`}
				class="flex flex-col rounded-lg border border-slate-200 bg-white p-5 transition-colors hover:border-brand-blue hover:shadow-sm dark:border-slate-800 dark:bg-slate-900"
			>
				<span class="inline-block w-fit rounded-full bg-brand-blue-light px-2.5 py-1 text-xs font-semibold text-brand-blue dark:bg-brand-blue/10 dark:text-sky-300">
					{categoryLabels[guide.data.category]}
				</span>
				<h2 class="mt-3 line-clamp-2 font-bold text-brand-navy dark:text-white">{guide.data.title}</h2>
				<p class="mt-2 line-clamp-2 text-sm text-slate-500 dark:text-slate-400">{guide.data.summary}</p>
				<p class="mt-4 text-xs text-slate-400 dark:text-slate-500">
					{dateFormatter.format(guide.data.updatedDate)} &middot; {readingTime(guide.body ?? '')} phút đọc
				</p>
			</a>
		))}
	</div>
</Layout>
