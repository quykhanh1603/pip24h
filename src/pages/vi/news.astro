---
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="vi" title="Lịch kinh tế — Pip24h" description="Lịch kinh tế forex trong tuần: sự kiện quan trọng, số liệu thực tế, dự báo và kỳ trước của các đồng tiền chính.">
	<h1 class="text-2xl font-bold text-brand-navy dark:text-white">Lịch kinh tế</h1>
	<p class="mt-2 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
		Các sự kiện kinh tế quan trọng của những đồng tiền chính trong tuần, cập nhật mỗi 6 giờ. Giờ hiển thị theo múi giờ thiết bị của bạn.
	</p>

	<div id="impact-filters" class="mt-5 flex flex-wrap gap-2">
		<button type="button" data-impact="all" class="rounded-full border px-3 py-1.5 text-xs font-medium cursor-pointer">Tất cả</button>
		<button type="button" data-impact="High" class="rounded-full border px-3 py-1.5 text-xs font-medium cursor-pointer">Ảnh hưởng cao</button>
		<button type="button" data-impact="Medium" class="rounded-full border px-3 py-1.5 text-xs font-medium cursor-pointer">Ảnh hưởng trung bình</button>
		<button type="button" data-impact="Low" class="rounded-full border px-3 py-1.5 text-xs font-medium cursor-pointer">Ảnh hưởng thấp</button>
	</div>

	<div id="calendar-root" class="mt-6">
		<p id="calendar-status" class="text-sm text-slate-500 dark:text-slate-400">Đang tải lịch kinh tế…</p>
	</div>

	<p class="mt-8 text-xs text-slate-400 dark:text-slate-500">
		Dữ liệu sự kiện kinh tế được lấy từ nguồn dữ liệu bên thứ ba, có thể chậm hoặc chưa đầy đủ. Hãy luôn xác nhận số liệu quan trọng với lịch kinh tế của sàn giao dịch trước khi vào lệnh.
	</p>
</Layout>

<script>
	const CALENDAR_URL = '/calendar-data.json';

	type CalendarEvent = {
		title: string;
		country: string;
		date: string;
		impact: string;
		forecast: string;
		previous: string;
	};

	const impactStyles: Record<string, string> = {
		High: 'bg-red-100 text-red-700 dark:bg-red-950/50 dark:text-red-300',
		Medium: 'bg-amber-100 text-amber-700 dark:bg-amber-950/50 dark:text-amber-300',
		Low: 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300',
		Holiday: 'bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400'
	};

	const activeTabClass = ['bg-brand-navy', 'text-white', 'border-brand-navy'];
	const inactiveTabClass = [
		'bg-white',
		'text-brand-navy',
		'border-slate-300',
		'dark:bg-slate-900',
		'dark:text-slate-300',
		'dark:border-slate-700'
	];

	let allEvents: CalendarEvent[] = [];
	let currentFilter = 'all';

	function render() {
		const root = document.getElementById('calendar-root')!;
		const filtered = currentFilter === 'all' ? allEvents : allEvents.filter((e) => e.impact === currentFilter);

		if (filtered.length === 0) {
			root.innerHTML = '<p class="text-sm text-slate-500 dark:text-slate-400">Không có sự kiện nào phù hợp.</p>';
			return;
		}

		const groups = new Map<string, CalendarEvent[]>();
		for (const ev of filtered) {
			const d = new Date(ev.date);
			const key = d.toLocaleDateString('vi-VN', { weekday: 'long', month: 'long', day: 'numeric' });
			if (!groups.has(key)) groups.set(key, []);
			groups.get(key)!.push(ev);
		}

		root.innerHTML = [...groups.entries()]
			.reverse()
			.map(([day, events]) => {
				const rows = events
					.map((ev) => {
						const d = new Date(ev.date);
						const time = d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
						const impactClass = impactStyles[ev.impact] ?? impactStyles.Low;
						return `
							<tr class="border-t border-slate-100 dark:border-slate-800">
								<td class="px-3 py-2.5 text-xs text-slate-500 dark:text-slate-400 whitespace-nowrap">${time}</td>
								<td class="px-3 py-2.5"><span class="rounded bg-brand-blue-light px-1.5 py-0.5 text-xs font-semibold text-brand-blue dark:bg-brand-blue/10 dark:text-sky-300">${ev.country}</span></td>
								<td class="px-3 py-2.5 text-sm font-medium text-slate-800 dark:text-slate-100">${ev.title}</td>
								<td class="px-3 py-2.5"><span class="rounded-full px-2 py-0.5 text-xs font-medium whitespace-nowrap ${impactClass}">${ev.impact || '—'}</span></td>
								<td class="px-3 py-2.5 text-sm text-slate-600 dark:text-slate-400 whitespace-nowrap">${ev.forecast || '—'}</td>
								<td class="px-3 py-2.5 text-sm text-slate-600 dark:text-slate-400 whitespace-nowrap">${ev.previous || '—'}</td>
							</tr>`;
					})
					.join('');
				return `
					<section class="mt-8 first:mt-0">
						<h2 class="text-sm font-bold text-brand-navy dark:text-white">${day}</h2>
						<div class="mt-3 overflow-x-auto rounded-lg border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
							<table class="w-full min-w-[640px] text-left">
								<thead class="bg-slate-50 text-xs text-slate-500 dark:bg-slate-950 dark:text-slate-400">
									<tr>
										<th class="px-3 py-2 font-semibold">Giờ</th>
										<th class="px-3 py-2 font-semibold">Tiền tệ</th>
										<th class="px-3 py-2 font-semibold">Sự kiện</th>
										<th class="px-3 py-2 font-semibold">Ảnh hưởng</th>
										<th class="px-3 py-2 font-semibold">Dự báo</th>
										<th class="px-3 py-2 font-semibold">Kỳ trước</th>
									</tr>
								</thead>
								<tbody>${rows}</tbody>
							</table>
						</div>
					</section>`;
			})
			.join('');
	}

	async function loadCalendar() {
		const status = document.getElementById('calendar-status');
		try {
			const res = await fetch(CALENDAR_URL);
			if (!res.ok) throw new Error('bad response');
			allEvents = await res.json();
			allEvents.sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
			render();
		} catch {
			if (status) status.textContent = 'Không tải được lịch kinh tế lúc này. Vui lòng thử lại sau ít phút.';
		}
	}

	document.getElementById('impact-filters')?.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest('button[data-impact]') as HTMLButtonElement | null;
		if (!btn) return;
		currentFilter = btn.dataset.impact!;
		document.querySelectorAll('#impact-filters button').forEach((b) => {
			b.classList.remove(...activeTabClass, ...inactiveTabClass);
			b.classList.add(...(b === btn ? activeTabClass : inactiveTabClass));
		});
		render();
	});

	document.querySelectorAll<HTMLButtonElement>('#impact-filters button').forEach((b, i) => {
		b.classList.add(...(i === 0 ? activeTabClass : inactiveTabClass));
	});

	loadCalendar();
</script>
