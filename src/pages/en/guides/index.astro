---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const guides = (await getCollection('guides', (entry) => entry.id.startsWith('en/'))).sort(
	(a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf()
);

const categoryLabels: Record<string, string> = {
	basics: 'Forex Basics',
	'risk-management': 'Risk Management',
	'technical-analysis': 'Technical Analysis',
	'chart-patterns': 'Chart Patterns',
	psychology: 'Trading Psychology',
	fundamentals: 'Fundamentals'
};

const dateFormatter = new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'long', year: 'numeric' });

function readingTime(body: string) {
	const words = body.trim().split(/\s+/).length;
	return Math.max(1, Math.round(words / 200));
}
---

<Layout lang="en" title="Trading Guides — Pip24h" description="Beginner-friendly guides covering forex basics, risk management, technical analysis, and chart patterns.">
	<h1 class="text-2xl font-bold text-brand-navy dark:text-white">Trading Guides</h1>
	<p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
		Showing <span class="font-semibold text-brand-navy dark:text-white">{guides.length}</span> guides
	</p>

	<div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
		{guides.map((guide) => (
			<a
				href={`/en/guides/${guide.id.split('/').slice(1).join('/')}/`}
				class="flex flex-col rounded-lg border border-slate-200 bg-white p-5 transition-colors hover:border-brand-blue hover:shadow-sm dark:border-slate-800 dark:bg-slate-900"
			>
				<span class="inline-block w-fit rounded-full bg-brand-blue-light px-2.5 py-1 text-xs font-semibold text-brand-blue dark:bg-brand-blue/10 dark:text-sky-300">
					{categoryLabels[guide.data.category]}
				</span>
				<h2 class="mt-3 line-clamp-2 font-bold text-brand-navy dark:text-white">{guide.data.title}</h2>
				<p class="mt-2 line-clamp-2 text-sm text-slate-500 dark:text-slate-400">{guide.data.summary}</p>
				<p class="mt-4 text-xs text-slate-400 dark:text-slate-500">
					{dateFormatter.format(guide.data.updatedDate)} &middot; {readingTime(guide.body ?? '')} min read
				</p>
			</a>
		))}
	</div>
</Layout>
