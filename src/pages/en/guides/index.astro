---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const guides = (await getCollection('guides', (entry) => entry.id.startsWith('en/'))).sort(
	(a, b) => a.data.title.localeCompare(b.data.title)
);

const categories = [
	{ key: 'basics', label: 'Forex Basics' },
	{ key: 'risk-management', label: 'Risk Management' },
	{ key: 'technical-analysis', label: 'Technical Analysis' },
	{ key: 'chart-patterns', label: 'Chart Patterns' }
] as const;
---

<Layout lang="en" title="Trading Guides — Pip24h" description="Beginner-friendly guides covering forex basics, risk management, technical analysis, and chart patterns.">
	<h1 class="text-2xl font-bold text-brand-navy">Trading Guides</h1>
	<p class="mt-2 max-w-2xl text-sm text-slate-600">
		Plain-language guides to help you understand forex trading, from the absolute basics to reading a chart.
	</p>

	{categories.map(({ key, label }) => {
		const items = guides.filter((g) => g.data.category === key);
		if (items.length === 0) return null;
		return (
			<section class="mt-10">
				<h2 class="text-lg font-bold text-brand-navy">{label}</h2>
				<div class="mt-4 grid gap-4 sm:grid-cols-2">
					{items.map((g) => (
						<a
							href={`/en/guides/${g.id.split('/').slice(1).join('/')}/`}
							class="rounded-lg border border-slate-200 bg-white p-4 hover:border-brand-blue"
						>
							<h3 class="font-semibold text-brand-navy">{g.data.title}</h3>
							<p class="mt-1 text-sm text-slate-500">{g.data.summary}</p>
						</a>
					))}
				</div>
			</section>
		);
	})}
</Layout>
