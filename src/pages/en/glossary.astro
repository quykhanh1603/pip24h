---
import Layout from '../../layouts/Layout.astro';

const terms = [
	{ term: 'Altcoin', def: 'Any cryptocurrency other than Bitcoin — for example Ethereum, Solana, or XRP.' },
	{ term: 'Ask (Offer) Price', def: 'The price at which you can buy an instrument. Always slightly higher than the bid price.' },
	{ term: 'Balance', def: 'The total cash in your trading account, not counting the profit or loss of any open positions.' },
	{ term: 'Bid Price', def: 'The price at which you can sell an instrument. Always slightly lower than the ask price.' },
	{ term: 'Blockchain', def: 'A distributed, tamper-resistant ledger that records transactions across many computers — the underlying technology behind Bitcoin and most cryptocurrencies.' },
	{ term: 'CFD (Contract for Difference)', def: 'A derivative contract that lets you trade on the price movement of an asset without owning it. Profit or loss is based on the difference between the opening and closing price.' },
	{ term: 'Cold Wallet', def: 'A cryptocurrency wallet kept offline (e.g. a hardware device), used for safer long-term storage since it isn\'t exposed to internet-based attacks.' },
	{ term: 'Drawdown', def: 'The drop from a peak in account equity to a subsequent low, usually expressed as a percentage — a key measure of risk exposure.' },
	{ term: 'ECN (Electronic Communication Network)', def: 'A trading model that matches buy and sell orders directly between market participants, typically offering tighter spreads plus a separate commission.' },
	{ term: 'Equity', def: 'Your account balance adjusted for the floating profit or loss of any currently open positions.' },
	{ term: 'Hedging', def: 'Opening a position to offset the risk of an existing one — for example holding both a long and short position on the same instrument.' },
	{ term: 'Hot Wallet', def: 'A cryptocurrency wallet connected to the internet, convenient for active trading but more exposed to hacking risk than a cold wallet.' },
	{ term: 'Leverage', def: 'Borrowed capital from a broker that lets you control a larger position than your deposit alone would allow — for example 1:100 leverage lets $100 control a $10,000 position. Leverage amplifies both gains and losses.' },
	{ term: 'Limit Order', def: 'An order to buy or sell only at a specified price or better, rather than at the current market price.' },
	{ term: 'Liquidity', def: 'How easily an asset can be bought or sold without significantly moving its price. Highly liquid markets (like major forex pairs) tend to have tighter spreads.' },
	{ term: 'Lot', def: 'A standardized trade size. A standard lot is 100,000 units of the base currency; a mini lot is 10,000; a micro lot is 1,000.' },
	{ term: 'Margin', def: 'The amount of your own funds a broker sets aside as collateral to open and hold a leveraged position.' },
	{ term: 'Margin Call', def: 'A warning from your broker that your account equity has fallen close to the required margin level, meaning you need to deposit more funds or reduce positions to avoid a stop out.' },
	{ term: 'Market Maker', def: 'A broker model where the broker takes the other side of client trades internally, rather than routing orders to external liquidity providers.' },
	{ term: 'Market Order', def: 'An order to buy or sell immediately at the current available market price.' },
	{ term: 'MetaTrader (MT4/MT5)', def: 'The most widely used third-party trading platforms in retail forex, offering charting, automated trading (EAs), and a common interface across many brokers.' },
	{ term: 'Overnight / Swap Fee (Rollover)', def: 'A fee or credit applied when a leveraged position is held open past the daily market close, reflecting the interest rate differential between the two currencies traded.' },
	{ term: 'Pip', def: 'The smallest standardized price movement for a currency pair, usually the fourth decimal place (or second, for pairs involving the Japanese yen).' },
	{ term: 'Regulator', def: 'A government or independent authority (such as the FCA, ASIC, or CySEC) that licenses and supervises brokers to protect client funds and enforce fair conduct.' },
	{ term: 'Scalping', def: 'A short-term trading style aiming to profit from small price movements, typically holding positions for seconds to minutes and placing many trades per day.' },
	{ term: 'Slippage', def: 'The difference between the price you expected an order to fill at and the price it actually filled at, usually caused by fast-moving markets or low liquidity.' },
	{ term: 'Spread', def: 'The difference between the bid and ask price of an instrument — one of the main ways brokers charge for trades.' },
	{ term: 'Stablecoin', def: 'A cryptocurrency designed to hold a stable value, usually pegged 1:1 to a fiat currency like the US dollar (e.g. USDT, USDC).' },
	{ term: 'Staking', def: 'Locking up cryptocurrency to help secure a proof-of-stake network, in exchange for rewards paid in that same cryptocurrency.' },
	{ term: 'Stop Loss', def: 'An order that automatically closes a position once the price reaches a specified level, used to limit potential losses.' },
	{ term: 'Stop Out Level', def: 'The margin level at which a broker will automatically start closing a trader\'s open positions to prevent the account balance from going negative.' },
	{ term: 'STP (Straight Through Processing)', def: 'A broker model that routes client orders directly to external liquidity providers without a dealing desk in between.' },
	{ term: 'Take Profit', def: 'An order that automatically closes a position once the price reaches a specified profit target.' },
	{ term: 'Volatility', def: 'How much and how quickly the price of an asset moves over a given period — higher volatility means larger, faster price swings.' },
	{ term: 'Volume', def: 'The total amount of an asset traded over a given period, often used as an indicator of market interest or liquidity.' }
];

const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const grouped = new Map<string, typeof terms>();
for (const item of [...terms].sort((a, b) => a.term.localeCompare(b.term))) {
	const letter = item.term[0].toUpperCase();
	if (!grouped.has(letter)) grouped.set(letter, []);
	grouped.get(letter)!.push(item);
}
---

<Layout lang="en" title="Forex &amp; Crypto Glossary — Pip24h" description="Plain-language definitions of common forex and crypto trading terms: pip, spread, leverage, margin, and more.">
	<article class="prose prose-slate dark:prose-invert max-w-none">
		<h1>Forex &amp; Crypto Glossary</h1>
		<p>
			Clear, plain-language definitions of the trading terms you'll run into most often on broker
			websites and in our reviews.
		</p>
	</article>

	<div class="sticky top-16 z-10 -mx-4 mt-6 flex flex-wrap gap-1.5 border-y border-slate-200 bg-slate-50/95 px-4 py-3 backdrop-blur sm:mx-0 sm:rounded-lg sm:border sm:px-3 dark:border-slate-800 dark:bg-slate-950/95">
		{alphabet.map((letter) =>
			grouped.has(letter) ? (
				<a
					href={`#letter-${letter}`}
					class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-300 text-sm font-semibold text-brand-navy hover:border-brand-blue hover:bg-brand-blue-light dark:border-slate-700 dark:text-slate-200 dark:hover:bg-brand-blue/10"
				>
					{letter}
				</a>
			) : (
				<span class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-100 text-sm text-slate-300 dark:border-slate-800 dark:text-slate-700">
					{letter}
				</span>
			)
		)}
	</div>

	<div class="mt-8 space-y-10">
		{[...grouped.entries()].map(([letter, items]) => (
			<section id={`letter-${letter}`} class="scroll-mt-24">
				<h2 class="text-xl font-bold text-brand-blue">{letter}</h2>
				<div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{items.map(({ term, def }) => (
						<div class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
							<h3 class="font-semibold text-brand-navy dark:text-white">{term}</h3>
							<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{def}</p>
						</div>
					))}
				</div>
			</section>
		))}
	</div>
</Layout>
