---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BrokerCard from '../../components/BrokerCard.astro';

const brokers = (await getCollection('brokers', (entry) => entry.id.startsWith('en/'))).sort(
	(a, b) => b.data.rating - a.data.rating
);
---

<Layout lang="en" title="Pip24h — Trusted Forex & Crypto Broker Reviews" description="Compare and review popular forex and crypto brokers: fees, platforms, and trustworthiness.">
	<h1 class="text-2xl font-bold">Forex & Crypto Broker Reviews</h1>
	<p class="mt-2 text-slate-600">Rankings based on trading fees, trustworthiness, platform quality, and real user experience.</p>

	<div class="mt-8 flex flex-col gap-4">
		{brokers.length === 0 && <p class="text-slate-500">No brokers added yet.</p>}
		{brokers.map((broker) => <BrokerCard broker={broker} lang="en" />)}
	</div>
</Layout>
