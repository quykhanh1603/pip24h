---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
	const brokers = await getCollection('brokers', (entry) => entry.id.startsWith('en/'));
	return brokers.map((broker) => ({
		params: { slug: broker.id.split('/').slice(1).join('/') },
		props: { broker }
	}));
}

const { broker } = Astro.props;
const { name, logo, rating, summary, foundedYear, minDeposit, spreadFrom, maxLeverage, regulation, platforms, pros, cons, badge } =
	broker.data;
const { Content } = await render(broker);
const slug = broker.id.split('/').slice(1).join('/');
---

<Layout lang="en" title={`${name} Review — Pip24h`} description={summary}>
	<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
		<div class="flex items-center gap-4">
			<img src={logo} alt={`${name} logo`} width="140" height="70" class="max-h-16 w-auto object-contain" />
			<div>
				<div class="flex items-center gap-2">
					<h1 class="text-2xl font-bold text-brand-navy dark:text-white">{name}</h1>
					{badge && <span class="rounded-full bg-brand-blue-light px-2.5 py-0.5 text-xs font-semibold text-brand-blue dark:bg-brand-blue/10 dark:text-sky-300">{badge}</span>}
				</div>
				<p class="text-sm text-slate-500 dark:text-slate-400">⭐ {rating.toFixed(1)}/5</p>
			</div>
		</div>
		<a
			href={`/go/${slug}/`}
			target="_blank"
			rel="nofollow sponsored noopener"
			class="rounded-md bg-brand-blue px-5 py-3 text-center text-sm font-semibold text-white hover:bg-brand-blue-dark"
		>
			Open account at {name}
		</a>
	</div>

	<dl class="mt-8 grid grid-cols-2 gap-4 rounded-lg border border-slate-200 bg-white p-5 sm:grid-cols-4 dark:border-slate-800 dark:bg-slate-900">
		<div>
			<dt class="text-xs text-slate-500 dark:text-slate-400">Founded</dt>
			<dd class="font-medium">{foundedYear ?? '—'}</dd>
		</div>
		<div>
			<dt class="text-xs text-slate-500 dark:text-slate-400">Min deposit</dt>
			<dd class="font-medium">{minDeposit ?? '—'}</dd>
		</div>
		<div>
			<dt class="text-xs text-slate-500 dark:text-slate-400">Spread from</dt>
			<dd class="font-medium">{spreadFrom ?? '—'}</dd>
		</div>
		<div>
			<dt class="text-xs text-slate-500 dark:text-slate-400">Max leverage</dt>
			<dd class="font-medium">{maxLeverage ?? '—'}</dd>
		</div>
		<div>
			<dt class="text-xs text-slate-500 dark:text-slate-400">Regulated by</dt>
			<dd class="font-medium">{regulation.length ? regulation.join(', ') : '—'}</dd>
		</div>
	</dl>

	{platforms.length > 0 && (
		<p class="mt-4 text-sm text-slate-600 dark:text-slate-400">
			<span class="font-medium text-slate-800 dark:text-slate-200">Trading platforms:</span> {platforms.join(', ')}
		</p>
	)}

	{(pros.length > 0 || cons.length > 0) && (
		<div class="mt-6 grid gap-4 sm:grid-cols-2">
			<div class="rounded-lg border border-green-200 bg-green-50 p-4 dark:border-green-900 dark:bg-green-950/40">
				<h2 class="font-semibold text-green-800 dark:text-green-300">Pros</h2>
				<ul class="mt-2 list-inside list-disc text-sm text-green-900 dark:text-green-200">
					{pros.map((p) => <li>{p}</li>)}
				</ul>
			</div>
			<div class="rounded-lg border border-red-200 bg-red-50 p-4 dark:border-red-900 dark:bg-red-950/40">
				<h2 class="font-semibold text-red-800 dark:text-red-300">Cons</h2>
				<ul class="mt-2 list-inside list-disc text-sm text-red-900 dark:text-red-200">
					{cons.map((c) => <li>{c}</li>)}
				</ul>
			</div>
		</div>
	)}

	<article class="prose prose-slate dark:prose-invert mt-8 max-w-none">
		<Content />
	</article>
</Layout>
