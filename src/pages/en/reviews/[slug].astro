---
import { getCollection } from 'astro:content';
import BrokerReview from '../../../components/BrokerReview.astro';
import { slugOf } from '../../../data/broker-score';

export async function getStaticPaths() {
	const brokers = await getCollection('brokers', (e) => e.id.startsWith('en/'));
	return brokers.map((broker) => ({ params: { slug: slugOf(broker) }, props: { broker } }));
}

const { broker } = Astro.props;
---

<BrokerReview broker={broker} lang="en" />
