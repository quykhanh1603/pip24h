---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	broker: CollectionEntry<'brokers'>;
	lang: 'vi' | 'en';
}

const { broker, lang } = Astro.props;
const { name, logo, rating, summary, assetType, minDeposit, spreadFrom } = broker.data;
const slug = broker.id.split('/').slice(1).join('/');

const assetTypeLabel = {
	forex: lang === 'vi' ? 'Forex' : 'Forex',
	crypto: lang === 'vi' ? 'Crypto' : 'Crypto',
	both: lang === 'vi' ? 'Forex & Crypto' : 'Forex & Crypto'
}[assetType];
---

<div class="flex flex-col gap-4 rounded-lg border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center">
	<div class="flex shrink-0 items-center justify-center">
		<Image src={logo} alt={`${name} logo`} width={120} height={60} class="max-h-14 w-auto object-contain" />
	</div>
	<div class="flex-1">
		<div class="flex items-center gap-2">
			<h3 class="text-lg font-semibold">{name}</h3>
			<span class="rounded bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700">{assetTypeLabel}</span>
		</div>
		<p class="mt-1 text-sm text-slate-600">{summary}</p>
		<div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
			<span>⭐ {rating.toFixed(1)}/5</span>
			{minDeposit && <span>{lang === 'vi' ? 'Nạp tối thiểu' : 'Min deposit'}: {minDeposit}</span>}
			{spreadFrom && <span>Spread: {spreadFrom}</span>}
		</div>
	</div>
	<div class="flex shrink-0 flex-col gap-2 sm:w-40">
		<a
			href={`/${lang}/reviews/${slug}/`}
			class="rounded-md border border-slate-300 px-3 py-2 text-center text-sm font-medium text-slate-700 hover:bg-slate-50"
		>
			{lang === 'vi' ? 'Xem đánh giá' : 'Read review'}
		</a>
		<a
			href={`/go/${slug}/`}
			target="_blank"
			rel="nofollow sponsored noopener"
			class="rounded-md bg-blue-700 px-3 py-2 text-center text-sm font-semibold text-white hover:bg-blue-800"
		>
			{lang === 'vi' ? 'Mở tài khoản' : 'Open account'}
		</a>
	</div>
</div>
