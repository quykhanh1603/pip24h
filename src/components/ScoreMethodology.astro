---
import Layout from '../layouts/Layout.astro';
import { brokerText, type Lang } from '../data/broker-i18n';
import { weights, type IndexKey, type LicenseStatus } from '../data/broker-score';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = brokerText[lang];
const m = t.methodology;
const indexKeys = Object.keys(weights) as IndexKey[];
const statuses: LicenseStatus[] = ['verified', 'unverified', 'revoked', 'clone-warning'];
---

<Layout lang={lang} title={`${m.title} — Pip24h`} description={m.description}>
	<div class="mx-auto max-w-3xl">
		<h1 class="text-2xl font-bold text-brand-navy dark:text-white">{m.title}</h1>
		<p class="mt-3 text-slate-600 dark:text-slate-400">{m.intro}</p>
		<p class="mt-4 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-200">
			{m.independence}
		</p>

		<ol class="mt-8 space-y-4">
			{indexKeys.map((k, i) => (
				<li class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
					<div class="flex items-baseline justify-between gap-3">
						<h2 class="font-bold text-brand-navy dark:text-white">
							{i + 1}. {t.indexes[k]}
						</h2>
						<span class="text-sm font-semibold text-slate-500 dark:text-slate-400">
							{m.weight} {Math.round(weights[k] * 100)}%
						</span>
					</div>
					<p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{m.details[k]}</p>
				</li>
			))}
		</ol>

		<h2 class="mt-10 text-lg font-bold text-brand-navy dark:text-white">{m.tiersTitle}</h2>
		<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{m.tiersIntro}</p>
		<ul class="mt-3 space-y-2 text-sm">
			{([1, 2, 3] as const).map((tier) => (
				<li>
					<span class="font-semibold">{t.tier[tier]}</span>: <span class="text-slate-600 dark:text-slate-400">{m.tiers[tier]}</span>
				</li>
			))}
		</ul>
		<p class="mt-2 text-sm">
			<a href={`/${lang}/regulators/`} class="text-brand-blue hover:underline">{t.regulatorsPage.title} →</a>
		</p>

		<h2 class="mt-10 text-lg font-bold text-brand-navy dark:text-white">{m.statusTitle}</h2>
		<ul class="mt-3 space-y-2 text-sm">
			{statuses.map((s) => (
				<li>
					<span class="font-semibold">{t.statusLabel[s]}</span>: <span class="text-slate-600 dark:text-slate-400">{t.statusHint[s]}</span>
				</li>
			))}
		</ul>

		<h2 class="mt-10 text-lg font-bold text-brand-navy dark:text-white">{m.overridesTitle}</h2>
		<p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{m.overrides}</p>

		<h2 class="mt-10 text-lg font-bold text-brand-navy dark:text-white">{m.bandsTitle}</h2>
		<p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{m.bands}</p>
	</div>
</Layout>
