---
import type { CollectionEntry } from 'astro:content';
import { propText, programTypes, slugOf, type Lang } from '../data/propfirm-i18n';

interface Props {
	firm: CollectionEntry<'propfirms'>;
	lang: Lang;
}

const { firm, lang } = Astro.props;
const t = propText[lang];
const { name, logo, rating, summary, badge, feeFrom, maxFunding, profitSplit, payoutFrequency, programs, pros } = firm.data;
const slug = slugOf(firm);
const metrics = [
	[t.feeFrom, feeFrom],
	[t.maxFunding, maxFunding ?? '—'],
	[t.profitSplit, profitSplit],
	[t.payout, payoutFrequency ?? '—']
];
---

<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
	<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
		<div class="flex items-start gap-4">
			<img src={logo} alt={`${name} logo`} width="56" height="56" class="h-14 w-14 shrink-0 rounded border border-slate-100 object-contain p-1 dark:border-slate-700" />
			<div>
				<div class="flex flex-wrap items-center gap-2">
					<h3 class="text-lg font-bold text-brand-navy dark:text-white">{name}</h3>
					{badge && (
						<span class="rounded-full bg-brand-blue-light px-2.5 py-0.5 text-xs font-semibold text-brand-blue dark:bg-brand-blue/10 dark:text-sky-300">{badge}</span>
					)}
					{programTypes(programs).map((type) => (
						<span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300">{t.type[type]}</span>
					))}
				</div>
				<p class="mt-1 text-sm text-amber-500" aria-hidden="true">
					{'★'.repeat(Math.round(rating))}{'☆'.repeat(5 - Math.round(rating))}
					<span class="ml-1 text-slate-500 dark:text-slate-400">{rating.toFixed(1)}</span>
				</p>
				<p class="mt-2 max-w-xl text-sm text-slate-600 dark:text-slate-400">{summary}</p>
			</div>
		</div>
		<div class="flex shrink-0 gap-2 sm:flex-col">
			<a
				href={`/${lang}/prop-firms/${slug}/`}
				class="rounded-md border border-slate-300 px-4 py-2 text-center text-sm font-medium text-brand-navy hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
			>
				{t.readReview}
			</a>
			<a
				href={`/go/${slug}/`}
				target="_blank"
				rel="nofollow sponsored noopener"
				class="rounded-md bg-brand-blue px-4 py-2 text-center text-sm font-semibold text-white hover:bg-brand-blue-dark"
			>
				{t.start}
			</a>
		</div>
	</div>

	<div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
		{metrics.map(([label, value]) => (
			<div class="rounded-lg bg-slate-50 px-3 py-2 dark:bg-slate-800">
				<p class="text-xs text-slate-500 dark:text-slate-400">{label}</p>
				<p class="text-sm font-semibold text-brand-navy dark:text-white">{value}</p>
			</div>
		))}
	</div>

	{pros.length > 0 && (
		<ul class="mt-5 grid gap-2 sm:grid-cols-3">
			{pros.slice(0, 3).map((p) => (
				<li class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-300">
					<span class="mt-0.5 text-brand-blue">✓</span>
					{p}
				</li>
			))}
		</ul>
	)}
</div>
