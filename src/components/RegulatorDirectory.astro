---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ScoreBadge from './ScoreBadge.astro';
import { brokerText, type Lang } from '../data/broker-i18n';
import { getBrokerScores, slugOf } from '../data/broker-score';
import { regulators } from '../data/regulators';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = brokerText[lang];
const p = t.regulatorsPage;
const scores = await getBrokerScores();
// Localised broker names come from this language's entries; licences come from the English ones.
const names = new Map((await getCollection('brokers', (e) => e.id.startsWith(`${lang}/`))).map((e) => [slugOf(e), e.data.name]));

const brokersByRegulator = new Map<string, { slug: string; name: string; total: number }[]>();
for (const [slug, { entry, score }] of scores) {
	const keys = new Set(score.licenses.filter((l) => l.regulator && l.status !== 'revoked').map((l) => l.regulator!.key));
	for (const key of keys) {
		const list = brokersByRegulator.get(key) ?? [];
		list.push({ slug, name: names.get(slug) ?? entry.data.name, total: score.total });
		brokersByRegulator.set(key, list);
	}
}
for (const list of brokersByRegulator.values()) list.sort((a, b) => b.total - a.total);
---

<Layout lang={lang} title={`${p.title} — Pip24h`} description={p.description}>
	<h1 class="text-2xl font-bold text-brand-navy dark:text-white">{p.title}</h1>
	<p class="mt-3 max-w-3xl text-slate-600 dark:text-slate-400">{p.intro}</p>

	{([1, 2, 3] as const).map((tier) => (
		<section class="mt-10">
			<h2 class="text-lg font-bold text-brand-navy dark:text-white">{t.tier[tier]}</h2>
			<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{t.methodology.tiers[tier]}</p>
			<div class="mt-4 grid gap-4 md:grid-cols-2">
				{regulators
					.filter((r) => r.tier === tier)
					.map((r) => {
						const list = brokersByRegulator.get(r.key) ?? [];
						return (
							<div id={r.key} class="scroll-mt-24 rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
								<div class="flex items-baseline justify-between gap-2">
									<h3 class="font-bold text-slate-900 dark:text-white">{r.abbr}</h3>
									<span class="text-xs text-slate-500 dark:text-slate-400">{r.country[lang]}</span>
								</div>
								<p class="text-sm text-slate-600 dark:text-slate-400">{r.name[lang]}</p>
								<a href={r.website} target="_blank" rel="noopener nofollow" class="mt-1 inline-block text-xs text-brand-blue hover:underline">
									{p.website} ↗
								</a>
								<p class="mt-3 text-xs font-medium text-slate-500 dark:text-slate-400">
									{p.brokers} ({list.length})
								</p>
								{list.length === 0 ? (
									<p class="mt-1 text-sm text-slate-400">{p.none}</p>
								) : (
									<ul class="mt-2 flex flex-wrap gap-2">
										{list.map((b) => (
											<li>
												<a
													href={`/${lang}/reviews/${b.slug}/`}
													class="flex items-center gap-1.5 rounded-md border border-slate-200 px-2 py-1 text-sm hover:border-brand-blue dark:border-slate-700"
												>
													{b.name} <ScoreBadge total={b.total} lang={lang} />
												</a>
											</li>
										))}
									</ul>
								)}
							</div>
						);
					})}
			</div>
		</section>
	))}
</Layout>
