---
interface Props {
	lang: 'vi' | 'en';
	title: string;
}

const { lang, title } = Astro.props;

const t = {
	vi: {
		badge: 'Sắp ra mắt',
		body: 'Chúng tôi đang xây dựng nội dung cho mục này. Quay lại sau nhé!',
		cta: 'Xem đánh giá sàn'
	},
	en: {
		badge: 'Coming Soon',
		body: "We're working on content for this section. Check back soon!",
		cta: 'Browse broker reviews'
	}
}[lang];
---

<section class="flex flex-col items-center py-20 text-center">
	<span class="rounded-full bg-brand-blue-light px-3 py-1 text-xs font-semibold text-brand-blue dark:bg-brand-blue/10 dark:text-sky-300">{t.badge}</span>
	<h1 class="mt-4 text-2xl font-bold text-brand-navy dark:text-white">{title}</h1>
	<p class="mt-2 max-w-md text-slate-500 dark:text-slate-400">{t.body}</p>
	<a
		href={`/${lang}/reviews/`}
		class="mt-6 inline-block rounded-md bg-brand-blue px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-blue-dark"
	>
		{t.cta}
	</a>
</section>
