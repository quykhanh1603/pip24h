---
// Google Analytics 4 loader.
//
// Deliberately *not* the snippet from the GA admin UI:
//   1. Consent Mode v2 defaults are pushed before gtag.js is created, so no `_ga` cookie is
//      written and GA4 sends cookieless pings until the visitor accepts (ConsentBanner.astro).
//   2. gtag.js is injected asynchronously from an inline script instead of a blocking
//      <script src>, so analytics can never delay the first paint.
//   3. Nothing is rendered at all when PUBLIC_GA_ID is unset — see src/config/analytics.ts.
//
// Cloudflare Web Analytics is a separate layer, injected by Pages at the edge; it is
// cookieless and needs no consent.
import { GA_MEASUREMENT_ID, gaEnabled } from '../config/analytics';

if (!gaEnabled) return;

// Resolved at build time so the rendered HTML contains the real loader URL — the deploy check
// (`npm run check:analytics`) greps for it.
const GA_SRC = `https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`;
---

<script is:inline define:vars={{ GA_MEASUREMENT_ID, GA_SRC }}>
	window.dataLayer = window.dataLayer || [];
	window.gtag = function gtag() {
		window.dataLayer.push(arguments);
	};

	// Consent Mode v2 — nothing non-essential is stored until the visitor chooses.
	// ad_* stay denied forever: this site runs no ads.
	window.gtag('consent', 'default', {
		ad_storage: 'denied',
		ad_user_data: 'denied',
		ad_personalization: 'denied',
		analytics_storage: 'denied',
		wait_for_update: 500
	});

	try {
		if (localStorage.getItem('pip24h-consent') === 'granted') {
			window.gtag('consent', 'update', { analytics_storage: 'granted' });
		}
	} catch (error) {
		/* storage blocked by the browser — consent stays denied */
	}

	window.gtag('js', new Date());
	window.gtag('config', GA_MEASUREMENT_ID, { anonymize_ip: true });

	// Queued commands above are replayed as soon as this script finishes loading.
	var loader = document.createElement('script');
	loader.async = true;
	loader.src = GA_SRC;
	document.head.appendChild(loader);
</script>
