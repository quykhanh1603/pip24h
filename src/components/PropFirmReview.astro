---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PropRiskNotice from './PropRiskNotice.astro';
import { propText, slugOf, type Lang } from '../data/propfirm-i18n';

interface Props {
	firm: CollectionEntry<'propfirms'>;
	lang: Lang;
}

const { firm, lang } = Astro.props;
const t = propText[lang];
const d = firm.data;
const slug = slugOf(firm);
const { Content } = await render(firm);

const title = lang === 'ja' ? `${d.name}の評判・ルール・参加費【2026年】 — Pip24h` : `${d.name} Review 2026 — Rules, Fees & Payouts | Pip24h`;

const facts = [
	[t.founded, d.foundedYear],
	[t.headquarters, d.headquarters],
	[t.accountSizes, d.accountSizes],
	[t.feeFrom, d.feeFrom],
	[t.maxFunding, d.maxFunding],
	[t.scaling, d.scalingUpTo],
	[t.payout, d.payoutFrequency],
	[t.trustpilot, d.trustpilotScore ? `★ ${d.trustpilotScore.toFixed(1)} / 5` : undefined]
].filter(([, v]) => v !== undefined && v !== '');

const permissionIcon = { allowed: '✅', restricted: '⚠️', 'not-allowed': '❌' } as const;
const rules = [
	[t.news, `${permissionIcon[d.newsTrading]} ${t.permission[d.newsTrading]}`],
	[t.weekend, `${permissionIcon[d.weekendHolding]} ${t.permission[d.weekendHolding]}`],
	[t.ea, d.eaAllowed ? `✅ ${t.permission.allowed}` : `❌ ${t.permission['not-allowed']}`]
];

const rows: [string, (p: (typeof d.programs)[number]) => string][] = [
	[t.evaluation, (p) => t.type[p.type]],
	[t.profitTarget, (p) => (p.profitTargets.length ? p.profitTargets.map((v) => `${v}%`).join(' → ') : t.none)],
	[t.dailyLoss, (p) => (p.maxDailyLoss !== undefined ? `${p.maxDailyLoss}%` : t.none)],
	[t.maxLoss, (p) => `${p.maxLoss}% (${t[p.maxLossType]})`],
	[t.minDays, (p) => (p.minTradingDays > 0 ? String(p.minTradingDays) : t.none)],
	[t.profitSplit, (p) => p.profitSplit],
	[t.feeRefund, (p) => (p.feeRefundable ? `✅ ${t.yes}` : t.no)]
];
---

<Layout lang={lang} title={title} description={d.summary}>
	<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
		<div class="flex items-center gap-4">
			<img src={d.logo} alt={`${d.name} logo`} width="72" height="72" class="h-16 w-16 rounded object-contain" />
			<div>
				<div class="flex flex-wrap items-center gap-2">
					<h1 class="text-2xl font-bold text-brand-navy dark:text-white">{d.name}</h1>
					{d.badge && (
						<span class="rounded-full bg-brand-blue-light px-2.5 py-0.5 text-xs font-semibold text-brand-blue dark:bg-brand-blue/10 dark:text-sky-300">{d.badge}</span>
					)}
				</div>
				<p class="text-sm text-slate-500 dark:text-slate-400">⭐ {d.rating.toFixed(1)}/5 · {t.profitSplit} {d.profitSplit}</p>
			</div>
		</div>
		<a
			href={`/go/${slug}/`}
			target="_blank"
			rel="nofollow sponsored noopener"
			class="rounded-md bg-brand-blue px-5 py-3 text-center text-sm font-semibold text-white hover:bg-brand-blue-dark"
		>
			{t.start}
		</a>
	</div>

	<div class="mt-6">
		<PropRiskNotice lang={lang} />
	</div>

	<dl class="mt-6 grid grid-cols-2 gap-4 rounded-lg border border-slate-200 bg-white p-5 sm:grid-cols-4 dark:border-slate-800 dark:bg-slate-900">
		{facts.map(([label, value]) => (
			<div>
				<dt class="text-xs text-slate-500 dark:text-slate-400">{label}</dt>
				<dd class="font-medium">{value}</dd>
			</div>
		))}
	</dl>

	{d.platforms.length > 0 && (
		<p class="mt-4 text-sm text-slate-600 dark:text-slate-400">
			<span class="font-medium text-slate-800 dark:text-slate-200">{t.platforms}:</span> {d.platforms.join(', ')}
		</p>
	)}

	<section class="mt-8">
		<h2 class="text-lg font-bold text-brand-navy dark:text-white">{t.programsTitle}</h2>
		<div class="mt-3 overflow-x-auto rounded-lg border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
			<table class="w-full min-w-[520px] text-left text-sm">
				<thead class="bg-slate-50 text-slate-700 dark:bg-slate-950 dark:text-slate-300">
					<tr>
						<th class="px-4 py-3"></th>
						{d.programs.map((p) => <th class="px-4 py-3 font-semibold">{p.name}</th>)}
					</tr>
				</thead>
				<tbody>
					{rows.map(([label, cell]) => (
						<tr class="border-t border-slate-100 dark:border-slate-800">
							<th scope="row" class="px-4 py-2.5 font-medium whitespace-nowrap text-slate-500 dark:text-slate-400">{label}</th>
							{d.programs.map((p) => <td class="px-4 py-2.5 text-slate-800 dark:text-slate-200">{cell(p)}</td>)}
						</tr>
					))}
				</tbody>
			</table>
		</div>
		{d.programs.filter((p) => p.note).map((p) => (
			<p class="mt-2 text-xs text-slate-500 dark:text-slate-400">* {p.name}: {p.note}</p>
		))}
	</section>

	<section class="mt-8">
		<h2 class="text-lg font-bold text-brand-navy dark:text-white">{t.rulesTitle}</h2>
		<ul class="mt-3 grid gap-3 sm:grid-cols-3">
			{rules.map(([label, value]) => (
				<li class="rounded-lg border border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-slate-900">
					<p class="text-xs text-slate-500 dark:text-slate-400">{label}</p>
					<p class="font-medium text-slate-800 dark:text-slate-200">{value}</p>
				</li>
			))}
		</ul>
	</section>

	{(d.pros.length > 0 || d.cons.length > 0) && (
		<div class="mt-8 grid gap-4 sm:grid-cols-2">
			<div class="rounded-lg border border-green-200 bg-green-50 p-4 dark:border-green-900 dark:bg-green-950/40">
				<h2 class="font-semibold text-green-800 dark:text-green-300">{t.pros}</h2>
				<ul class="mt-2 list-inside list-disc text-sm text-green-900 dark:text-green-200">
					{d.pros.map((p) => <li>{p}</li>)}
				</ul>
			</div>
			<div class="rounded-lg border border-red-200 bg-red-50 p-4 dark:border-red-900 dark:bg-red-950/40">
				<h2 class="font-semibold text-red-800 dark:text-red-300">{t.cons}</h2>
				<ul class="mt-2 list-inside list-disc text-sm text-red-900 dark:text-red-200">
					{d.cons.map((c) => <li>{c}</li>)}
				</ul>
			</div>
		</div>
	)}

	<article class="prose prose-slate dark:prose-invert mt-8 max-w-none">
		<Content />
	</article>

	<p class="mt-10 text-sm">
		<a href={`/${lang}/prop-firms/`} class="text-brand-blue hover:underline">{t.back}</a>
	</p>
</Layout>
