---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
	title: string;
	description?: string;
	lang: 'vi' | 'en';
}

const { title, description = '', lang } = Astro.props;
const otherLang = lang === 'vi' ? 'en' : 'vi';
const switchedPath = Astro.url.pathname.replace(/^\/(vi|en)/, `/${otherLang}`);

const navText = {
	vi: {
		topBrokers: 'Sàn hàng đầu',
		news: 'Tin tức',
		guides: 'Hướng dẫn',
		glossary: 'Từ điển',
		compare: 'So sánh',
		about: 'Giới thiệu',
		reviews: 'Đánh giá sàn'
	},
	en: {
		topBrokers: 'Top Brokers',
		news: 'News',
		guides: 'Guides',
		glossary: 'Glossary',
		compare: 'Compare',
		about: 'About',
		reviews: 'Broker Reviews'
	}
}[lang];

const navItems = [
	{ key: 'topBrokers', href: `/${lang}/` },
	{ key: 'news', href: `/${lang}/news/` },
	{ key: 'guides', href: `/${lang}/guides/` },
	{ key: 'glossary', href: `/${lang}/glossary/` },
	{ key: 'compare', href: `/${lang}/#comparison` },
	{ key: 'about', href: `/${lang}/about/` }
];

const currentPath = Astro.url.pathname;

const footerText = {
	vi: {
		mission: 'Pip24h giúp trader Việt Nam chọn sàn forex, crypto uy tín thông qua đánh giá độc lập, kiểm tra bằng tài khoản thật.',
		quickLinks: 'Liên kết nhanh',
		topBrokers: 'Sàn nổi bật',
		legal: 'Pháp lý',
		privacy: 'Chính sách bảo mật',
		terms: 'Điều khoản & Cảnh báo rủi ro',
		disclosure: 'Công bố Affiliate',
		risk: 'Giao dịch forex/crypto tiềm ẩn rủi ro cao. Nội dung mang tính tham khảo, không phải lời khuyên đầu tư.',
		affiliate: 'Một số liên kết trên trang là liên kết affiliate — chúng tôi có thể nhận hoa hồng khi bạn đăng ký qua các liên kết này.',
		rights: 'Bảo lưu mọi quyền.'
	},
	en: {
		mission: 'Pip24h helps traders choose trustworthy forex and crypto brokers through independent, real-account-tested reviews.',
		quickLinks: 'Quick Links',
		topBrokers: 'Top Brokers',
		legal: 'Legal',
		privacy: 'Privacy Policy',
		terms: 'Terms & Risk Disclaimer',
		disclosure: 'Affiliate Disclosure',
		risk: 'Trading forex/crypto carries significant risk. Content is for informational purposes only, not investment advice.',
		affiliate: 'Some links on this site are affiliate links — we may earn a commission if you sign up through them.',
		rights: 'All rights reserved.'
	}
}[lang];

const brokers = await getCollection('brokers', (entry) => entry.id.startsWith(`${lang}/`));
const topBrokers = [...brokers]
	.sort((a, b) => b.data.rating - a.data.rating)
	.slice(0, 5);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<title>{title}</title>
		<script is:inline>
			const storedTheme = localStorage.getItem('theme');
			if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
		<header class="sticky top-0 z-40 bg-brand-navy dark:border-b dark:border-slate-800 dark:bg-slate-950">
			<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3">
				<a href={`/${lang}/`} class="flex items-center">
					<img src="/images/logo.png" alt="Pip24h" class="h-11 w-auto sm:h-12" />
				</a>
				<nav class="flex flex-wrap items-center gap-1 text-sm font-medium text-slate-300">
					{navItems.map((item) => {
						const isActive = item.href === `/${lang}/` ? currentPath === `/${lang}/` : currentPath.startsWith(item.href.split('#')[0]);
						return (
							<a
								href={item.href}
								class:list={[
									'rounded-full px-3 py-1.5 transition-colors',
									isActive ? 'bg-brand-blue text-white' : 'hover:text-white'
								]}
							>
								{navText[item.key as keyof typeof navText]}
							</a>
						);
					})}
				</nav>
				<div class="flex items-center gap-2">
					<button
						id="theme-toggle"
						type="button"
						aria-label="Toggle dark mode"
						class="flex h-7 w-7 items-center justify-center rounded-full border border-slate-500 text-slate-200 hover:border-white hover:text-white"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="block h-4 w-4 dark:hidden">
							<path d="M12 3a1 1 0 011 1v1a1 1 0 11-2 0V4a1 1 0 011-1zm0 15a5 5 0 100-10 5 5 0 000 10zm9-6a1 1 0 100-2h-1a1 1 0 100 2h1zM4 12a1 1 0 100-2H3a1 1 0 100 2h1zm14.95-6.36a1 1 0 010 1.41l-.7.71a1 1 0 11-1.42-1.41l.71-.71a1 1 0 011.41 0zM6.46 17.54a1 1 0 010 1.41l-.71.71a1 1 0 11-1.41-1.41l.7-.71a1 1 0 011.42 0zM12 20a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zm6.54-1.46a1 1 0 011.41 0l.71.7a1 1 0 01-1.41 1.42l-.71-.71a1 1 0 010-1.41zM5.05 5.05a1 1 0 011.41 0l.71.71A1 1 0 015.76 7.17l-.71-.71a1 1 0 010-1.41z" />
						</svg>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="hidden h-4 w-4 dark:block">
							<path d="M21.64 13a1 1 0 00-1.05-.14 8.05 8.05 0 01-3.37.73 8.15 8.15 0 01-8.14-8.14c0-1.15.24-2.29.73-3.37A1 1 0 008.6 1.05 10.14 10.14 0 1023 15.4a1 1 0 00-1.36-2.4z" />
						</svg>
					</button>
					<a
						href={switchedPath}
						class="rounded-full border border-slate-500 px-3 py-1 text-xs font-semibold text-slate-200 hover:border-white hover:text-white"
					>
						{lang === 'vi' ? 'VI' : 'EN'} <span class="text-slate-500">/</span> {lang === 'vi' ? 'EN' : 'VI'}
					</a>
				</div>
			</div>
		</header>
		<main class="mx-auto max-w-6xl px-4 py-8">
			<slot />
		</main>
		<footer class="mt-16 border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
			<div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-12 sm:grid-cols-4">
				<div class="col-span-2 sm:col-span-1">
					<a href={`/${lang}/`} class="inline-block">
						<img src="/images/logo.png" alt="Pip24h" class="h-14 w-auto" />
					</a>
					<p class="mt-3 text-sm text-slate-500 dark:text-slate-400">{footerText.mission}</p>
				</div>
				<div>
					<h3 class="text-sm font-semibold text-brand-navy dark:text-white">{footerText.quickLinks}</h3>
					<ul class="mt-3 space-y-2 text-sm text-slate-500 dark:text-slate-400">
						<li><a href={`/${lang}/`} class="hover:text-brand-blue">{navText.topBrokers}</a></li>
						<li><a href={`/${lang}/reviews/`} class="hover:text-brand-blue">{navText.reviews}</a></li>
						<li><a href={`/${lang}/guides/`} class="hover:text-brand-blue">{navText.guides}</a></li>
						<li><a href={`/${lang}/glossary/`} class="hover:text-brand-blue">{navText.glossary}</a></li>
						<li><a href={`/${lang}/about/`} class="hover:text-brand-blue">{navText.about}</a></li>
					</ul>
				</div>
				<div>
					<h3 class="text-sm font-semibold text-brand-navy dark:text-white">{footerText.topBrokers}</h3>
					<ul class="mt-3 space-y-2 text-sm text-slate-500 dark:text-slate-400">
						{topBrokers.map((broker) => (
							<li>
								<a href={`/${lang}/reviews/${broker.id.split('/').slice(1).join('/')}/`} class="hover:text-brand-blue">
									{broker.data.name}
								</a>
							</li>
						))}
					</ul>
				</div>
				<div>
					<h3 class="text-sm font-semibold text-brand-navy dark:text-white">{footerText.legal}</h3>
					<ul class="mt-3 space-y-2 text-sm text-slate-500 dark:text-slate-400">
						<li><a href={`/${lang}/privacy/`} class="hover:text-brand-blue">{footerText.privacy}</a></li>
						<li><a href={`/${lang}/terms/`} class="hover:text-brand-blue">{footerText.terms}</a></li>
						<li><a href={`/${lang}/affiliate-disclosure/`} class="hover:text-brand-blue">{footerText.disclosure}</a></li>
					</ul>
				</div>
			</div>
			<div class="border-t border-slate-200 px-4 py-6 text-center text-xs text-slate-400 dark:border-slate-800 dark:text-slate-500">
				<p>{footerText.risk}</p>
				<p class="mt-1">{footerText.affiliate}</p>
				<p class="mt-3">&copy; {new Date().getFullYear()} Pip24h. {footerText.rights}</p>
			</div>
		</footer>
		<script is:inline>
			document.getElementById('theme-toggle')?.addEventListener('click', () => {
				const isDark = document.documentElement.classList.toggle('dark');
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
			});
		</script>
	</body>
</html>
