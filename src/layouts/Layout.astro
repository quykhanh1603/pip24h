---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
	title: string;
	description?: string;
	lang: 'vi' | 'en';
}

const { title, description = '', lang } = Astro.props;
const otherLang = lang === 'vi' ? 'en' : 'vi';
const switchedPath = Astro.url.pathname.replace(/^\/(vi|en)/, `/${otherLang}`);

const navText = {
	vi: {
		topBrokers: 'Sàn hàng đầu',
		news: 'Tin tức',
		guides: 'Hướng dẫn',
		glossary: 'Từ điển',
		compare: 'So sánh',
		about: 'Giới thiệu',
		reviews: 'Đánh giá sàn'
	},
	en: {
		topBrokers: 'Top Brokers',
		news: 'News',
		guides: 'Guides',
		glossary: 'Glossary',
		compare: 'Compare',
		about: 'About',
		reviews: 'Broker Reviews'
	}
}[lang];

const navItems = [
	{ key: 'topBrokers', href: `/${lang}/` },
	{ key: 'news', href: `/${lang}/news/` },
	{ key: 'guides', href: `/${lang}/guides/` },
	{ key: 'glossary', href: `/${lang}/glossary/` },
	{ key: 'compare', href: `/${lang}/#comparison` },
	{ key: 'about', href: `/${lang}/about/` }
];

const currentPath = Astro.url.pathname;

const footerText = {
	vi: {
		mission: 'Pip24h giúp trader Việt Nam chọn sàn forex, crypto uy tín thông qua đánh giá độc lập, kiểm tra bằng tài khoản thật.',
		quickLinks: 'Liên kết nhanh',
		topBrokers: 'Sàn nổi bật',
		legal: 'Pháp lý',
		privacy: 'Chính sách bảo mật',
		terms: 'Điều khoản & Cảnh báo rủi ro',
		disclosure: 'Công bố Affiliate',
		risk: 'Giao dịch forex/crypto tiềm ẩn rủi ro cao. Nội dung mang tính tham khảo, không phải lời khuyên đầu tư.',
		affiliate: 'Một số liên kết trên trang là liên kết affiliate — chúng tôi có thể nhận hoa hồng khi bạn đăng ký qua các liên kết này.',
		rights: 'Bảo lưu mọi quyền.'
	},
	en: {
		mission: 'Pip24h helps traders choose trustworthy forex and crypto brokers through independent, real-account-tested reviews.',
		quickLinks: 'Quick Links',
		topBrokers: 'Top Brokers',
		legal: 'Legal',
		privacy: 'Privacy Policy',
		terms: 'Terms & Risk Disclaimer',
		disclosure: 'Affiliate Disclosure',
		risk: 'Trading forex/crypto carries significant risk. Content is for informational purposes only, not investment advice.',
		affiliate: 'Some links on this site are affiliate links — we may earn a commission if you sign up through them.',
		rights: 'All rights reserved.'
	}
}[lang];

const brokers = await getCollection('brokers', (entry) => entry.id.startsWith(`${lang}/`));
const topBrokers = [...brokers]
	.sort((a, b) => b.data.rating - a.data.rating)
	.slice(0, 5);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-slate-50 text-slate-900">
		<header class="bg-brand-navy">
			<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3">
				<a href={`/${lang}/`} class="text-lg font-extrabold text-white">
					Pip<span class="text-brand-blue-light">24h</span>
				</a>
				<nav class="flex flex-wrap items-center gap-1 text-sm font-medium text-slate-300">
					{navItems.map((item) => {
						const isActive = item.href === `/${lang}/` ? currentPath === `/${lang}/` : currentPath.startsWith(item.href.split('#')[0]);
						return (
							<a
								href={item.href}
								class:list={[
									'rounded-full px-3 py-1.5 transition-colors',
									isActive ? 'bg-brand-blue text-white' : 'hover:text-white'
								]}
							>
								{navText[item.key as keyof typeof navText]}
							</a>
						);
					})}
				</nav>
				<a
					href={switchedPath}
					class="rounded-full border border-slate-500 px-3 py-1 text-xs font-semibold text-slate-200 hover:border-white hover:text-white"
				>
					{lang === 'vi' ? 'VI' : 'EN'} <span class="text-slate-500">/</span> {lang === 'vi' ? 'EN' : 'VI'}
				</a>
			</div>
		</header>
		<main class="mx-auto max-w-6xl px-4 py-8">
			<slot />
		</main>
		<footer class="mt-16 border-t border-slate-200 bg-white">
			<div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-12 sm:grid-cols-4">
				<div class="col-span-2 sm:col-span-1">
					<a href={`/${lang}/`} class="text-lg font-extrabold text-brand-navy">
						Pip<span class="text-brand-blue">24h</span>
					</a>
					<p class="mt-3 text-sm text-slate-500">{footerText.mission}</p>
				</div>
				<div>
					<h3 class="text-sm font-semibold text-brand-navy">{footerText.quickLinks}</h3>
					<ul class="mt-3 space-y-2 text-sm text-slate-500">
						<li><a href={`/${lang}/`} class="hover:text-brand-blue">{navText.topBrokers}</a></li>
						<li><a href={`/${lang}/reviews/`} class="hover:text-brand-blue">{navText.reviews}</a></li>
						<li><a href={`/${lang}/guides/`} class="hover:text-brand-blue">{navText.guides}</a></li>
						<li><a href={`/${lang}/glossary/`} class="hover:text-brand-blue">{navText.glossary}</a></li>
						<li><a href={`/${lang}/about/`} class="hover:text-brand-blue">{navText.about}</a></li>
					</ul>
				</div>
				<div>
					<h3 class="text-sm font-semibold text-brand-navy">{footerText.topBrokers}</h3>
					<ul class="mt-3 space-y-2 text-sm text-slate-500">
						{topBrokers.map((broker) => (
							<li>
								<a href={`/${lang}/reviews/${broker.id.split('/').slice(1).join('/')}/`} class="hover:text-brand-blue">
									{broker.data.name}
								</a>
							</li>
						))}
					</ul>
				</div>
				<div>
					<h3 class="text-sm font-semibold text-brand-navy">{footerText.legal}</h3>
					<ul class="mt-3 space-y-2 text-sm text-slate-500">
						<li><a href={`/${lang}/privacy/`} class="hover:text-brand-blue">{footerText.privacy}</a></li>
						<li><a href={`/${lang}/terms/`} class="hover:text-brand-blue">{footerText.terms}</a></li>
						<li><a href={`/${lang}/affiliate-disclosure/`} class="hover:text-brand-blue">{footerText.disclosure}</a></li>
					</ul>
				</div>
			</div>
			<div class="border-t border-slate-200 px-4 py-6 text-center text-xs text-slate-400">
				<p>{footerText.risk}</p>
				<p class="mt-1">{footerText.affiliate}</p>
				<p class="mt-3">&copy; {new Date().getFullYear()} Pip24h. {footerText.rights}</p>
			</div>
		</footer>
	</body>
</html>
